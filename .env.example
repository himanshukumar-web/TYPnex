# ==========================================================
# TYPnex Production & Development Configuration Template
# ==========================================================

# Application Port & URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL / Supabase Database Connection
# Production connection with connection pooling
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# Direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Supabase Credentials (Required for Supabase Storage & RLS)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="typnex-files"

# Cryptographic & Session Secrets (Keep strictly private)
SESSION_SECRET="generate-a-secure-random-64-character-secret"
JWT_SECRET="generate-a-secure-random-64-character-jwt-secret"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Transactional Email Provider (Resend / SendGrid / AWS SES)
EMAIL_PROVIDER_KEY="your-transactional-email-api-key"
EMAIL_FROM_ADDRESS="no-reply@typnex.com"

# Multilingual Translation API (Google Cloud / DeepL / LibreTranslate)
TRANSLATION_API_KEY="your-cloud-translation-api-key"
TRANSLATION_API_URL="https://translation.googleapis.com/language/translate/v2"

# Ad Monetization Partner Keys (USER role ads only)
AD_PROVIDER_KEY="your-ad-network-client-or-slot-id"

# Initial Seeding Credentials (Only used during initial deployment seed, change immediately after first login)
DEFAULT_ADMIN_EMAIL="admin@typnex.com"
DEFAULT_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword@2026"
DEFAULT_EMPLOYEE_EMAIL="employee@typnex.com"
DEFAULT_EMPLOYEE_PASSWORD="ReplaceWithStrongEmployeePassword@2026"
